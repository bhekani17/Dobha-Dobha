{
  "family": "skytrade-app-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "containerDefinitions": [
    {
      "name": "skytrade-app",
      "image": "REPLACE_WITH_ECR_URI",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "PORT",
          "value": "3000"
        },
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "USERS_TABLE",
          "value": "skytrade-users"
        },
        {
          "name": "ITEMS_TABLE",
          "value": "skytrade-items"
        },
        {
          "name": "MESSAGES_TABLE",
          "value": "skytrade-messages"
        },
        {
          "name": "WISHLISTS_TABLE",
          "value": "skytrade-wishlists"
        },
        {
          "name": "CARTS_TABLE",
          "value": "skytrade-carts"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/skytrade-app",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}

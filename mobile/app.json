{
  "expo": {
    "name": "DOBHA DOBHA",
    "slug": "dobha-dobha",
    "scheme": "sky-local-trade",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dobhadobha.app",
      "infoPlist": {
        "NSCameraUsageDescription": "DOBHA DOBHA uses camera for scanning Escrow pickup QR codes and photographing thrift pieces.",
        "NSPhotoLibraryUsageDescription": "DOBHA DOBHA uses your photo library to upload thrift pieces and verification documents.",
        "NSMicrophoneUsageDescription": "DOBHA DOBHA uses the microphone when broadcasting a live stream."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0d14"
      },
      "package": "com.dobhadobha.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "./withCleartextTraffic.js",
      "expo-video",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "owner": "ndlovubhekani17",
    "extra": {
      "eas": {
        "projectId": "5962ec47-449c-497a-8846-5741d118c8ac"
      }
    }
  }
}

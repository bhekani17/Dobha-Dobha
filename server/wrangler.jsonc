{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dobha-live",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // The Flutter web build (npm run build:web). API routes live under /api and
  // photos under /photos, which never match a file, so they reach the Worker.
  "assets": { "directory": "../mobile/build/web" },

  // LIVEKIT_URL, LIVEKIT_API_KEY and LIVEKIT_API_SECRET are secrets:
  //   npx wrangler secret put LIVEKIT_API_SECRET
  // For local dev they come from .dev.vars (copy .dev.vars.example).

  // OAuth client ids whose Google ID tokens the server accepts (comma-separated).
  // Use the "Web application" client id; add the iOS one too if iOS sign-in is set up.
  // Client ids are public, so they live here rather than in secrets.
  "vars": { "GOOGLE_CLIENT_IDS": "787923055628-acjg6j5smm778vt2b3mtcss6so61niaj.apps.googleusercontent.com,787923055628-gm7j2ss8g15o30drcdmls7ugsh2t22vq.apps.googleusercontent.com" },

  // Accounts, listings, orders and the simulated wallet.
  // Schema: migrations/ (npm run db:migrate, or db:migrate:local for wrangler dev).
  "d1_databases": [
    { "binding": "DB", "database_name": "dobha", "database_id": "2df55e04-7723-476b-b7ac-1e8567e4eb24" }
  ],

  // Item photos.
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "dobha-photos" }],

  "durable_objects": {
    "bindings": [{ "name": "CLAIMS", "class_name": "StreamClaims" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StreamClaims"] }],

  "ratelimits": [
    { "name": "TOKEN_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "AUTH_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ]
}

{
  "name": "dobha-marketplace-aws-prototype",
  "version": "1.0.0",
  "private": true,
  "description": "Partial AWS SAM marketplace API migration prototype.",
  "scripts": {
    "test": "node --check src/app.js && node --check src/orders.js && node --check src/notification_relay.js && node --check src/notification_worker.js && node --test test/*.test.js",
    "sam:validate": "sam validate --template-file template.yaml",
    "sam:build": "sam build --template-file template.yaml",
    "deploy": "sam deploy --guided --template-file template.yaml --stack-name dobha-marketplace-prototype-dev"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.800.0",
    "@aws-sdk/client-dynamodb": "^3.800.0",
    "@aws-sdk/client-sqs": "^3.800.0",
    "@aws-sdk/client-s3": "^3.800.0",
    "@aws-sdk/lib-dynamodb": "^3.800.0",
    "@aws-sdk/s3-presigned-post": "^3.800.0",
    "@aws-sdk/s3-request-presigner": "^3.800.0",
    "@aws-sdk/util-dynamodb": "^3.800.0",
    "livekit-server-sdk": "^2.13.3"
  }
}

# DOBHA DOBHA - Environment Configuration

# Server Settings
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:8081,http://localhost:8082

# MongoDB
MONGODB_URI=mongodb://localhost:27017/dobha-dobha

# Authentication (JWT)
JWT_SECRET=replace-with-a-strong-jwt-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-strong-jwt-refresh-secret-at-least-32-chars

# Mobile Expo client
EXPO_PUBLIC_API_URL=http://localhost:3000

# Google OAuth Configuration (for mobile app)
EXPO_PUBLIC_ANDROID_GOOGLE_CLIENT_ID=your_android_google_client_id
EXPO_PUBLIC_IOS_GOOGLE_CLIENT_ID=your_ios_google_client_id
EXPO_PUBLIC_WEB_GOOGLE_CLIENT_ID=your_web_google_client_id

# Logo.dev API
LOGO_DEV_PUBLISHABLE_KEY=pk_your_publishable_key
LOGO_DEV_SECRET_KEY=sk_your_secret_key

# Mux live streaming (create tokens at dashboard.mux.com -> Settings -> Access tokens)
# Self-hosted nginx-rtmp — set to your VPS IP or domain (no protocol, no trailing slash)
# e.g. 123.456.78.90  or  rtmp.myserver.com
RTMP_SERVER_URL=localhost

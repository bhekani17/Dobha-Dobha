# SKY TRADE (DOBHA DOBHA) Environment Configuration

# DOBHA DOBHA - Environment Configuration

# Server Settings
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:8081,http://localhost:8082

# Authentication (JWT)
JWT_SECRET=replace-with-a-strong-jwt-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-strong-jwt-refresh-secret-at-least-32-chars

# Neon PostgreSQL (Lakebase Postgres)
# DATABASE_URL: Neon connection URL with connection pooling (pgbouncer) - provided by Neon CLI
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.neon.tech/neondb?pgbouncer=true&connection_limit=1
# DIRECT_URL: Neon direct database URL, used only by Prisma migrations (no connection pooling)
DIRECT_URL=postgresql://postgres:PASSWORD@aws-0-REGION.neon.tech/neondb

# Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL=https://PROJECT_REF.neon.tech
NEON_AUTH_JWKS_URL=https://PROJECT_REF.neon.tech/.well-known/jwks.json

# Neon Object Storage (S3-compatible)
AWS_ACCESS_KEY_ID=your_neon_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_neon_aws_secret_access_key
AWS_ENDPOINT_URL_S3=https://PROJECT_ID-s3.PROJECT_REGION.neon.tech
AWS_S3_BUCKET_NAME=assets
AWS_REGION=us-east-2

# Mobile Expo client
EXPO_PUBLIC_API_URL=http://localhost:3000

# Google OAuth Configuration (for mobile app)
EXPO_PUBLIC_ANDROID_GOOGLE_CLIENT_ID=your_android_google_client_id
EXPO_PUBLIC_IOS_GOOGLE_CLIENT_ID=your_ios_google_client_id
EXPO_PUBLIC_WEB_GOOGLE_CLIENT_ID=your_web_google_client_id

# Logo.dev API Configuration
LOGO_DEV_PUBLISHABLE_KEY=pk_your_publishable_key
LOGO_DEV_SECRET_KEY=sk_your_secret_key
# Mux live streaming (create tokens at dashboard.mux.com -> Settings -> Access tokens)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
